# Copy to frontend/.env.local (dev: npm run dev) or frontend/.env.production (build: npm run build)
# Read when Vite starts or builds: rebuild after any change

# false: call the real backend. true or missing: fake data, no backend needed
VITE_USE_MOCK=false

# Address of the backend, without /api and without trailing slash
# Leave empty in dev: Vite forwards /api to http://localhost:5000
VITE_API_URL=

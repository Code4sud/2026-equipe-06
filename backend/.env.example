# Copy to backend/.env (full server: make dev / make up)
# or to backend/.env.local (local test server: python -m ai.dev_server, only MISTRAL_API_KEY is needed)

# --- Server ---
APP_NAME=backend
HOST=0.0.0.0
PORT=8000
# Address of the frontend, for CORS (no trailing slash)
FRONTEND_URL=https://your-frontend.example.com
DB_URI=mongodb+srv://user:password@cluster.example.mongodb.net
DB_NAME=pioche_ta_voix

# --- Login code by e-mail (Brevo) ---
# Without BREVO_API_KEY, the code is only written in the server logs
BREVO_API_KEY=
# Sender address, verified in Brevo
MAIL_FROM=
MAIL_FROM_NAME=Pioche ta voix

# --- AI (Mistral) ---
MISTRAL_API_KEY=
# Optional, defaults shown
# AI_CHAT_MODEL=mistral-medium-latest
# AI_ANALYSIS_MODEL=mistral-medium-latest
# AI_SUMMARY_MODEL=mistral-medium-latest
# AI_STT_MODEL=voxtral-mini-latest
# AI_TTS_MODEL=voxtral-mini-tts-3-0
# ID of a voice from your Mistral account (none: default voice)
# AI_TTS_VOICE=
# AI_TTS_EXPRESSIVENESS_NEUTRAL=1.0
# AI_TTS_EXPRESSIVENESS_ENTHUSIASTIC=2.0

# Never in production: skips the login code
# AUTH_SKIP_CODE=1
